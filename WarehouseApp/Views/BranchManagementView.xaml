<UserControl x:Class="WarehouseApp.Views.BranchManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Left: branch list -->
        <DataGrid x:Name="dgBranches" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" Margin="0,0,10,0"
                  SelectionChanged="DgBranches_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"      Binding="{Binding BRANCH_ID}" Width="50"/>
                <DataGridTextColumn Header="Name"    Binding="{Binding BRANCH_NAME}" Width="*"/>
                <DataGridTextColumn Header="City"    Binding="{Binding CITY}" Width="*"/>
                <DataGridTextColumn Header="Address" Binding="{Binding ADDRESS}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Right: form -->
        <StackPanel Grid.Column="1">
            <TextBlock Text="Branch Details" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="Branch name *"/>
            <TextBox x:Name="txtName" Margin="0,2,0,8"/>

            <TextBlock Text="City"/>
            <TextBox x:Name="txtCity" Margin="0,2,0,8"/>

            <TextBlock Text="Address"/>
            <TextBox x:Name="txtAddress" Margin="0,2,0,12"/>

            <UniformGrid Columns="2">
                <Button Content="Add"    Click="BtnAdd_Click"    Margin="0,0,5,5" Padding="5"/>
                <Button Content="Update" Click="BtnUpdate_Click" Margin="5,0,0,5" Padding="5"/>
                <Button Content="Delete" Click="BtnDelete_Click" Margin="0,5,5,0" Padding="5"/>
                <Button Content="Clear"  Click="BtnClear_Click"  Margin="5,5,0,0" Padding="5"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
<UserControl x:Class="WarehouseApp.Views.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="dgProducts" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" Margin="0,0,10,0"
                  SelectionChanged="DgProducts_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"         Binding="{Binding PRODUCT_ID}" Width="50"/>
                <DataGridTextColumn Header="Name"       Binding="{Binding PRODUCT_NAME}" Width="*"/>
                <DataGridTextColumn Header="Category"   Binding="{Binding CATEGORY}" Width="*"/>
                <DataGridTextColumn Header="Unit Price" Binding="{Binding UNIT_PRICE}" Width="90"/>
                <DataGridTextColumn Header="Min. Stock" Binding="{Binding MIN_STOCK_LEVEL}" Width="80"/>
                <DataGridTextColumn Header="Supplier"   Binding="{Binding SUPPLIER_NAME}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Product Details" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="Product name *"/>
            <TextBox x:Name="txtName" Margin="0,2,0,8"/>

            <TextBlock Text="Category"/>
            <TextBox x:Name="txtCategory" Margin="0,2,0,8"/>

            <TextBlock Text="Unit price"/>
            <TextBox x:Name="txtPrice" Margin="0,2,0,8"/>

            <TextBlock Text="Minimum stock level"/>
            <TextBox x:Name="txtMinStock" Margin="0,2,0,8"/>

            <TextBlock Text="Supplier"/>
            <ComboBox x:Name="cmbSupplier" Margin="0,2,0,12"
                      DisplayMemberPath="SUPPLIER_NAME" SelectedValuePath="SUPPLIER_ID"/>

            <UniformGrid Columns="2">
                <Button Content="Add"    Click="BtnAdd_Click"    Margin="0,0,5,5" Padding="5"/>
                <Button Content="Update" Click="BtnUpdate_Click" Margin="5,0,0,5" Padding="5"/>
                <Button Content="Delete" Click="BtnDelete_Click" Margin="0,5,5,0" Padding="5"/>
                <Button Content="Clear"  Click="BtnClear_Click"  Margin="5,5,0,0" Padding="5"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
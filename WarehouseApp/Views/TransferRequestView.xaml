<UserControl x:Class="WarehouseApp.Views.TransferRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top: new request form -->
        <GroupBox Header="New Transfer Request" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Source branch:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox x:Name="cmbSource" Grid.Column="1" Margin="0,0,0,6"
                          DisplayMemberPath="BRANCH_NAME" SelectedValuePath="BRANCH_ID"
                          SelectionChanged="CmbSource_SelectionChanged"/>

                <TextBlock Text="Destination branch:" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox x:Name="cmbDest" Grid.Column="4" Margin="0,0,0,6"
                          DisplayMemberPath="BRANCH_NAME" SelectedValuePath="BRANCH_ID"/>

                <TextBlock Text="Product:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox x:Name="cmbProduct" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                          DisplayMemberPath="PRODUCT_NAME" SelectedValuePath="PRODUCT_ID"
                          SelectionChanged="CmbProduct_SelectionChanged"/>

                <TextBlock Text="Quantity:" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox x:Name="txtQuantity" Grid.Row="1" Grid.Column="4" Margin="0,0,0,6"/>

                <TextBlock x:Name="txtAvailable" Grid.Row="2" Grid.Column="1" Foreground="Gray"/>
                <Button Content="Create Request" Grid.Row="2" Grid.Column="4"
                        Padding="5" Click="BtnCreate_Click"/>
            </Grid>
        </GroupBox>

        <!-- Middle: action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,5">
            <TextBlock Text="Transfer Requests" FontWeight="Bold" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="Execute Transfer" Padding="8,3" Margin="0,0,8,0"
                    FontWeight="Bold" Click="BtnExecute_Click"/>
            <Button Content="Reject Selected" Padding="8,3" Margin="0,0,8,0" Click="BtnReject_Click"/>
            <Button Content="Refresh" Padding="8,3" Margin="0,0,20,0" Click="BtnRefresh_Click"/>
            <CheckBox x:Name="chkSimulateError" Content="Simulate error (rollback demo)"
                      VerticalAlignment="Center" Foreground="DarkRed"/>
        </StackPanel>

        <!-- Bottom: request list -->
        <DataGrid x:Name="dgRequests" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Request ID"  Binding="{Binding REQUEST_ID}" Width="80"/>
                <DataGridTextColumn Header="Source"      Binding="{Binding SOURCE_NAME}" Width="*"/>
                <DataGridTextColumn Header="Destination" Binding="{Binding DEST_NAME}" Width="*"/>
                <DataGridTextColumn Header="Product"     Binding="{Binding PRODUCT_NAME}" Width="*"/>
                <DataGridTextColumn Header="Quantity"    Binding="{Binding QUANTITY}" Width="70"/>
                <DataGridTextColumn Header="Status"      Binding="{Binding STATUS}" Width="90"/>
                <DataGridTextColumn Header="Request Date"
                                    Binding="{Binding REQUEST_DATE, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
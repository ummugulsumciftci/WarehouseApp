<UserControl x:Class="WarehouseApp.Views.StockSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Product name:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtProductName" Width="180" Margin="0,0,15,0"/>

            <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtCategory" Width="120" Margin="0,0,15,0"/>

            <TextBlock Text="Branch:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="cmbBranch" Width="160" Margin="0,0,15,0"
                      DisplayMemberPath="BRANCH_NAME" SelectedValuePath="BRANCH_ID"/>

            <Button Content="Search" Width="80" Click="BtnSearch_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgStock" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Branch"    Binding="{Binding BRANCH_NAME}" Width="*"/>
                <DataGridTextColumn Header="Product"   Binding="{Binding PRODUCT_NAME}" Width="*"/>
                <DataGridTextColumn Header="Category"  Binding="{Binding CATEGORY}" Width="*"/>
                <DataGridTextColumn Header="Supplier"  Binding="{Binding SUPPLIER_NAME}" Width="*"/>
                <DataGridTextColumn Header="Quantity"  Binding="{Binding QUANTITY}" Width="80"/>
                <DataGridTextColumn Header="Min. Stock" Binding="{Binding MIN_STOCK_LEVEL}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
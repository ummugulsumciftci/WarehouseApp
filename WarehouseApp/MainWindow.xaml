<Window x:Class="WarehouseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WarehouseApp.Views"
        Title="Multi-Branch Warehouse Inventory System" Height="600" Width="1000">
    <TabControl>
        <TabItem Header="Stock Search">
            <views:StockSearchView/>
        </TabItem>
        <TabItem Header="Branches">
            <views:BranchManagementView/>
        </TabItem>
        <TabItem Header="Products">
            <views:ProductManagementView/>
        </TabItem>
        <TabItem Header="Suppliers">
            <views:SupplierManagementView/>
        </TabItem>
        <TabItem Header="Transfers">
            <views:TransferRequestView/>
        </TabItem>
        <TabItem Header="Shipments">
            <views:ShipmentTrackingView/>
        </TabItem>
    </TabControl>
</Window>